# ==============================================================================
# Solve School Problems - Environment Configuration Template
# ==============================================================================

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-3.8-flash

# Hybrid Local LLM (Primary: rtx5060lp / Fallback: kenomac-mini / LM Studio: sff7020) & Draw Things Image Generation (kenomac-mini)
OLLAMA_HOST=http://rtx5060lp:11434
OLLAMA_WRITER_MODEL=shosetsu
DRAW_THINGS_HOST=http://kenomac-mini:7860
LM_STUDIO_HOST=http://sff7020:1234

# WordPress & Blogger Mail Post Receiver Settings
WP_POST_EMAIL=your-secret-wp-email-address@post.wordpress.com
BLOGGER_POST_EMAIL=your-username.secret@blogger.com
DEFAULT_POST_STATUS=publish
USE_JETPACK_SHORTCODES=true

# SMTP Server Settings (Example: Gmail / Outlook SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MAIL_FROM_NAME=Solve School Problems Bot
