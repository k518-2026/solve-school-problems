# ==============================================================================
# Solve School Problems - Environment Configuration Template
# ==============================================================================

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-3.8-flash

# WordPress Mail Post Receiver Settings (Jetpack "Post by Email" or Postie)
WP_POST_EMAIL=your-secret-wp-email-address@post.wordpress.com
DEFAULT_POST_STATUS=publish
USE_JETPACK_SHORTCODES=true

# SMTP Server Settings (Example: Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MAIL_FROM_NAME=Solve School Problems Bot
